{
  "name": "zemda-desktop",
  "productName": "Zemda",
  "version": "1.1.2",
  "description": "Zemda - Tecnologia em Saúde e Gestão Integrada",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "sync:frontend": "node copy-renderer.js",
    "pack": "node copy-renderer.js && electron-builder --dir",
    "dist": "node copy-renderer.js && electron-builder",
    "dist:win": "node copy-renderer.js && electron-builder --win nsis --x64"
  },
  "author": "Zemda Tecnologia",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.medschedule.app",
    "productName": "Zemda",
    "copyright": "Copyright © 2026 Zemda",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "main.js",
      "preload.js",
      "assets/**/*",
      "renderer/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.ico",
      "artifactName": "Zemda Setup ${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Zemda",
      "uninstallDisplayName": "Zemda Gestão Integrada",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    }
  }
}
