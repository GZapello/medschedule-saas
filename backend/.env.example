# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env de verdade — ele já está no .gitignore.

# --- Núcleo do servidor ---
PORT=4000
NODE_ENV=development
DATABASE_PATH=./saas_schedule.db

# --- Segurança (obrigatórias — o servidor não inicia sem elas) ---
# Gere valores aleatórios, por exemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ZEMDA_FILES_SIGNING_SECRET=

# Chave usada para assinar códigos de verificação de e-mail (obrigatória apenas quando o fluxo de verificação é usado)
EMAIL_OTP_SECRET=

# Chave de criptografia AES-256 dos tokens do WhatsApp Cloud (obrigatória apenas quando a integração de WhatsApp é usada)
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# CORS: origens de navegador autorizadas a chamar a API, separadas por vírgula
# Apps nativos (Android/Electron) não enviam Origin e não são afetados por esta lista.
ALLOWED_ORIGINS=https://zemda.com.br,https://www.zemda.com.br,http://localhost:5173,http://localhost:4000

# Habilita a clínica e as contas fictícias de demonstração (senha "123456") no banco vazio.
# Use "true" apenas em ambiente local/demo. NUNCA em produção com clientes reais.
SEED_DEMO_DATA=false

# --- URLs públicas ---
APP_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
FRONTEND_DIST_PATH=

# --- E-mail transacional (Resend) ---
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SUPPORT_EMAIL=

# --- Pagamentos (Asaas) — ver backend/asaas.env.example ---
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=

# --- IA (Google Gemini) ---
GEMINI_API_KEY=
GEMINI_MODEL=
GOOGLE_API_KEY=

# --- WhatsApp Cloud / Meta ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=
META_WHATSAPP_CONFIG_ID=

# --- Armazenamento de arquivos (Cloudflare R2 / S3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_MOCK_STORAGE=true
ZEMDA_FILES_WORKER_URL=
CLINIC_UPLOAD_ROOT=

# --- Analytics / SEO ---
GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=

# --- Login social (se aplicável) ---
PSC_PROVIDER=
PSC_CLIENT_ID=
PSC_CLIENT_SECRET=
