# URL HTTPS do APK hospedado separadamente; vazio oculta o link.
# Variáveis VITE são públicas. Não usar URLs com credenciais/tokens secretos.
VITE_ZEMDA_ANDROID_TEST_DOWNLOAD_URL=
# Client ID WEB já aceito pelo endpoint de autenticação existente (não é segredo).
# Cadastrar também cliente OAuth Android com br.com.zemda.app + SHA-1 de cada assinatura.
VITE_GOOGLE_CLIENT_ID=
